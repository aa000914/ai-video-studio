# DashScope (阿里云百炼)
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# Qwen 文本模型
QWEN_TEXT_MODEL=qwen3.7-max-preview

# 图片生成
QWEN_IMAGE_MODEL=qwen-image-2.0-pro
QWEN_IMAGE_FALLBACK_MODEL=qwen-image-2.0

# 视频生成 — HappyHorse 全能模型（主力，支持图生+文生）
# 后续切换 Seedance 2.0 只需改这个变量
HAPPYHORSE_VIDEO_MODEL=happyhorse-1.0-video

# 视频生成 — WAN 模型（HappyHorse 失败时自动回退）
WAN_I2V_MODEL=wan2.7-i2v-2026-04-25
WAN_T2V_MODEL=wan2.7-t2v
WAN_VIDEO_EDIT_MODEL=wan2.7-videoedit
HAPPYHORSE_VIDEO_EDIT_MODEL=happyhorse-1.0-video-edit

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
